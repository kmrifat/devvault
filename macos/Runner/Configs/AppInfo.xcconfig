// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = DevVault

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.binarycastle.devvault

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Binary Castle. All rights reserved.

// In-place updates with Sparkle (ADR-0007 §3). Each release attaches an
// appcast signed with the update key; the app checks it with this public
// half. While SPARKLE_PUBLIC_ED_KEY is empty the app can't update itself
// and offers View Release instead (docs/release.md › macOS updates).
SPARKLE_FEED_URL = https:/$()/github.com/kmrifat/devvault/releases/latest/download/appcast.xml
SPARKLE_PUBLIC_ED_KEY =
