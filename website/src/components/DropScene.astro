---
// Hero: a .p8 key is dragged from the desktop into DevVault, the import
// sheet shows what the file says, the user fills in the Team ID (it isn't in
// a .p8), and the item lands in the vault. Wording follows the app
// (import_dialog.dart, N04-import frame).
import Icon from './Icon.astro';
import { u } from '../lib/url';

const rows = [
  { icon: 'shield-check', name: 'Distribution certificate', sub: 'iOS · Production', type: 'Certificate', exp: 'Expired', tone: 'bad' },
  { icon: 'flame', name: 'Firebase config', sub: 'Android · Production', type: 'Firebase', exp: '—' },
  { icon: 'user', name: 'Play publisher', sub: 'Android · Production', type: 'Service account', exp: '12 days', tone: 'warn' },
  { icon: 'key', name: 'Stripe secret key', sub: 'Server · Production', type: 'Secret', exp: '—' },
  { icon: 'lock', name: 'Upload keystore', sub: 'kitchenly-upload.jks', type: 'Keystore', exp: 'Jan 2051' },
  { icon: 'shield', name: 'Web OAuth client', sub: 'Web · Production', type: 'OAuth client', exp: '—' },
];
---
<div class="fit drop" data-w="1000" data-h="640">
  <div class="stage" data-scene data-steps="500,1300,1600,2200,2900,3400,3700,4200,5100,6100,6800,7000,7500" data-loop="11000">
    <!-- Desktop file -->
    <div class="dfile">
      <div class="dfile-icon">
        <span class="dfile-ext">P8</span>
      </div>
      <span class="dfile-name">AuthKey_8G4K2LXQ9R.p8</span>
    </div>

    <!-- App window -->
    <div class="win">
      <aside class="side">
        <div class="lights"><i></i><i></i><i></i></div>
        <div class="brand">
          <img src={u('icon.png')} alt="" width="26" height="26" />
          <div><b>DevVault</b><small><span class="n11">11</span><span class="n12">12</span> items · this device</small></div>
        </div>
        <nav>
          <a class="on"><Icon name="layers" size={14} /> All items <em><span class="n11">11</span><span class="n12">12</span></em></a>
          <a><Icon name="clock" size={14} class="ic-warn" /> Expiring in 30 days <em>1</em></a>
          <a><Icon name="x-circle" size={14} class="ic-bad" /> Expired <em>1</em></a>
        </nav>
        <h6>Apps</h6>
        <nav>
          <a><span class="dot" style="background:#14a364">K</span> Kitchenly <em><span class="n11">9</span><span class="n12">10</span></em></a>
          <a><span class="dot" style="background:#7c4dff">L</span> Ledgerly <em>1</em></a>
        </nav>
        <h6>Tags</h6>
        <nav>
          <a><Icon name="tag" size={14} /> push</a>
          <a><Icon name="tag" size={14} /> release</a>
          <a><Icon name="tag" size={14} /> signing</a>
        </nav>
      </aside>

      <section class="main">
        <header class="bar">
          <div class="bar-title"><b>All items</b><small><span class="n11">11</span><span class="n12">12</span> items</small></div>
          <span class="tbtn"><Icon name="file" size={13} /> Import</span>
          <span class="tbtn blue"><Icon name="plus" size={13} /> New</span>
          <span class="search"><Icon name="search" size={13} /> Search items, key IDs, fingerprints</span>
        </header>

        <div class="cols">
          <div class="list">
            <div class="thead"><span>Name</span><span>Type</span><span>Expires</span></div>
            <div class="row new">
              <Icon name="key" size={14} />
              <span class="nm"><b>APNs auth key</b><small>iOS · Production</small></span>
              <span class="ty">Auth key</span>
              <span class="ex">—</span>
            </div>
            {rows.map((r) => (
              <div class="row">
                <Icon name={r.icon} size={14} />
                <span class="nm"><b>{r.name}</b><small>{r.sub}</small></span>
                <span class="ty">{r.type}</span>
                <span class={`ex ${r.tone ?? ''}`}>{r.exp}</span>
              </div>
            ))}
          </div>

          <div class="detail">
            <div class="empty">
              <Icon name="file" size={26} stroke={1.5} />
              <b>No item selected</b>
              <small>Drop a file anywhere in the window.</small>
            </div>
            <div class="item">
              <div class="item-head">
                <span class="item-ic"><Icon name="key" size={18} /></span>
                <div><b>APNs auth key</b><small>Apple Auth Key · iOS · Production</small></div>
              </div>
              <div class="fields">
                <div><span>Key ID</span><code>8G4K2LXQ9R</code><i class="ff"><Icon name="file" size={10} /> From file</i></div>
                <div><span>Algorithm</span><code>EC P-256</code><i class="ff"><Icon name="file" size={10} /> From file</i></div>
                <div><span>Team ID</span><code>A1B2C3D4E5</code></div>
                <div><span>Private key</span><code class="dots">●●●●●●●●</code></div>
              </div>
              <p class="note"><Icon name="clock" size={12} /> No expiry date in the file.</p>
            </div>
          </div>
        </div>

        <footer class="status">
          <span><span class="n11">11</span><span class="n12">12</span> items</span>
          <span class="enc"><Icon name="lock" size={11} /> End-to-end encrypted</span>
        </footer>
      </section>

      <!-- Drop target -->
      <div class="dropzone"><span><Icon name="download" size={18} /> Drop to import</span></div>

      <!-- Import sheet -->
      <div class="scrim"></div>
      <div class="sheet">
        <div class="sh-head">
          <span class="sh-ic"><Icon name="shield" size={18} /></span>
          <div>
            <b>Import AuthKey_8G4K2LXQ9R.p8</b>
            <small><Icon name="check-circle" size={11} /> Apple Auth Key · 241 bytes</small>
          </div>
        </div>
        <div class="sh-label">Details <i class="ff"><Icon name="file" size={10} /> From the file</i></div>
        <div class="sh-facts">
          <div class="fact f1"><span>Key algorithm</span><code>EC P-256</code></div>
          <div class="fact f2"><span>Key ID</span><code>8G4K2LXQ9R</code></div>
        </div>
        <div class="sh-row"><label>Name</label><span class="inp t-name"><span class="type">APNs auth key</span></span></div>
        <div class="sh-row"><label>Team ID</label><span class="inp t-team"><span class="type mono">A1B2C3D4E5</span><span class="ph mono">A1B2C3D4E5</span><em class="done"><Icon name="check" size={12} /></em></span><em class="req">Required · not in the file</em></div>
        <div class="sh-foot">
          <small><Icon name="check-circle" size={11} /> Read on this device, stored encrypted.</small>
          <span class="b-cancel">Cancel</span>
          <span class="b-add">Add to Vault</span>
        </div>
      </div>

      <div class="toast"><Icon name="check-circle" size={14} /> File imported</div>
    </div>

    <!-- Pointer -->
    <svg class="cur" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 2.5v17.2l4.6-4.3 2.9 6.7 2.9-1.2-2.9-6.6H18L4 2.5z" fill="#111" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
  </div>
</div>

<style>
  .drop { font-family: var(--font); color: var(--app-text); }
  .stage { overflow: hidden; }

  /* ---------- window ---------- */
  .win {
    position: absolute; left: 130px; top: 34px; width: 840px; height: 572px;
    background: var(--app-bg);
    border-radius: 14px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / .1), 0 40px 80px -20px rgb(90 20 40 / .35), 0 12px 30px -10px rgb(0 0 0 / .18);
    display: flex; overflow: hidden;
    font-size: 12px;
  }
  .side {
    width: 196px; flex: none; background: var(--app-side);
    border-right: 1px solid var(--app-line);
    padding: 12px 10px;
  }
  .lights { display: flex; gap: 7px; margin: 0 0 14px 4px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .brand { display: flex; gap: 8px; align-items: center; margin: 0 4px 12px; }
  .brand img { border-radius: 6px; }
  .brand b { display: block; font-size: 12.5px; }
  .brand small, .bar-title small { color: var(--app-muted); font-size: 10.5px; }
  .side nav { display: grid; gap: 1px; }
  .side a {
    display: flex; align-items: center; gap: 8px;
    padding: 5px 8px; border-radius: 6px; font-size: 12px;
  }
  .side a.on { background: var(--app-sel); color: #fff; }
  .side a em { margin-left: auto; font-style: normal; color: var(--app-muted); font-size: 11px; }
  .side a.on em { color: rgb(255 255 255 / .85); }
  .side h6 { margin: 14px 8px 4px; font-size: 10.5px; color: var(--app-muted); font-weight: 600; }
  .dot { width: 15px; height: 15px; border-radius: 4px; color: #fff; font-size: 9px; font-weight: 700; display: grid; place-items: center; }
  .ic-warn { color: #e08a00; } .ic-bad { color: var(--danger); }

  .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .bar { height: 50px; display: flex; align-items: center; gap: 8px; padding: 0 14px; border-bottom: 1px solid var(--app-line); }
  .bar-title { width: 120px; } .bar-title b { display: block; font-size: 12.5px; }
  .tbtn {
    display: inline-flex; align-items: center; gap: 5px;
    height: 24px; padding: 0 9px; border-radius: 6px; font-weight: 500;
    background: #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / .12), 0 1px 1px rgb(0 0 0 / .06);
  }
  .tbtn.blue { background: var(--app-sel); color: #fff; box-shadow: none; }
  .search {
    margin-left: auto; width: 230px; height: 26px; border-radius: 7px;
    background: #ececef; color: var(--app-muted);
    display: inline-flex; align-items: center; gap: 6px; padding: 0 9px; font-size: 11.5px;
  }
  .cols { flex: 1; display: flex; min-height: 0; }
  .list { width: 330px; border-right: 1px solid var(--app-line); overflow: hidden; }
  .thead, .row { display: grid; grid-template-columns: 18px 1fr 92px 62px; align-items: center; gap: 8px; padding: 0 12px; }
  .thead { height: 26px; color: var(--app-muted); font-size: 10.5px; font-weight: 600; grid-template-columns: 1fr 92px 62px; padding-left: 38px; border-bottom: 1px solid var(--app-line); }
  .row { height: 40px; color: var(--app-text); }
  .row:nth-child(even) { background: var(--app-row); }
  .row :global(svg) { color: var(--app-muted); }
  .nm b { display: block; font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nm small { color: var(--app-muted); font-size: 10.5px; }
  .ty { color: var(--app-muted); font-size: 11px; }
  .ex { font-size: 11px; }
  .ex.warn { color: var(--warn); background: var(--warn-bg); border-radius: 4px; padding: 1px 5px; font-weight: 600; justify-self: start; }
  .ex.bad { color: var(--danger); font-weight: 600; }

  .row.new {
    height: 0; opacity: 0; overflow: hidden;
    background: var(--app-sel); color: #fff;
    transition: height .45s cubic-bezier(.2,.8,.2,1), opacity .3s;
  }
  .row.new :global(svg), .row.new small, .row.new .ty, .row.new .ex { color: rgb(255 255 255 / .85); }

  .detail { flex: 1; position: relative; }
  .empty {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 4px;
    color: var(--app-muted); transition: opacity .3s;
  }
  .empty b { color: var(--app-text); font-size: 12.5px; margin-top: 6px; }
  .item { position: absolute; inset: 0; padding: 18px; opacity: 0; transform: translateY(6px); transition: opacity .4s .15s, transform .4s .15s; }
  .item-head { display: flex; gap: 10px; align-items: center; margin-bottom: 16px; }
  .item-head b { font-size: 15px; display: block; }
  .item-head small { color: var(--app-muted); font-size: 11px; }
  .item-ic { width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; background: #e7f0ff; color: var(--app-sel); }
  .fields { border: 1px solid var(--app-line); border-radius: 9px; overflow: hidden; }
  .fields > div { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border-top: 1px solid var(--app-line); font-size: 11.5px; }
  .fields > div:first-child { border-top: 0; }
  .fields span { width: 72px; color: var(--app-muted); }
  .fields code { font-family: var(--mono); font-size: 11px; }
  .fields .ff { margin-left: auto; }
  .dots { letter-spacing: 1px; font-size: 9px !important; }
  .note { display: flex; gap: 6px; align-items: center; color: var(--app-muted); font-size: 11px; margin-top: 12px; }

  .ff {
    display: inline-flex; align-items: center; gap: 3px;
    font-style: normal; font-size: 9.5px; color: var(--app-muted);
    border: 1px solid var(--app-line); border-radius: 5px; padding: 1px 5px;
  }

  .status {
    height: 24px; border-top: 1px solid var(--app-line);
    display: flex; justify-content: space-between; align-items: center; padding: 0 12px;
    font-size: 10.5px; color: var(--app-muted);
  }
  .enc { display: inline-flex; gap: 4px; align-items: center; transition: color .3s; }

  .n12 { display: none; }

  /* ---------- drop zone ---------- */
  .dropzone {
    position: absolute; inset: 8px; border-radius: 10px;
    border: 2px dashed var(--brand); background: rgb(225 29 72 / .07);
    display: grid; place-items: center; opacity: 0; transition: opacity .25s;
    pointer-events: none;
  }
  .dropzone span {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--brand); color: #fff; font-weight: 600; font-size: 13px;
    padding: 8px 14px; border-radius: 999px; box-shadow: 0 8px 20px -6px rgb(225 29 72 / .6);
  }

  /* ---------- import sheet ---------- */
  .scrim { position: absolute; inset: 0; background: rgb(0 0 0 / .18); opacity: 0; transition: opacity .3s; }
  .sheet {
    position: absolute; left: 200px; top: 70px; width: 440px; height: 330px;
    background: #fff; border-radius: 12px; padding: 18px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / .1), 0 30px 60px -10px rgb(0 0 0 / .35);
    opacity: 0; transform: translateY(-14px) scale(.98); transition: opacity .3s, transform .35s cubic-bezier(.2,.8,.2,1);
    display: flex; flex-direction: column; gap: 10px;
  }
  .sh-head { display: flex; gap: 10px; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--app-line); }
  .sh-head b { font-size: 13px; display: block; }
  .sh-head small { display: inline-flex; gap: 4px; align-items: center; color: var(--app-muted); font-size: 11px; }
  .sh-head small :global(svg) { color: var(--ok); }
  .sh-ic { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; background: #e7f0ff; color: var(--app-sel); }
  .sh-label { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 11px; color: var(--app-muted); }
  .sh-facts { border: 1px solid var(--app-line); border-radius: 8px; padding: 6px 12px; min-height: 52px; }
  .fact { display: flex; gap: 12px; font-size: 11.5px; height: 20px; align-items: center; opacity: 0; transform: translateX(-6px); transition: opacity .3s, transform .3s; }
  .fact span { width: 84px; text-align: right; color: var(--app-muted); }
  .fact code { font-family: var(--mono); font-size: 11px; background: #fff7d1; border-radius: 3px; padding: 0 3px; transition: background 1.2s .6s; }
  .sh-row { display: flex; align-items: center; gap: 10px; }
  .sh-row label { width: 64px; text-align: right; font-size: 11.5px; }
  .inp {
    position: relative; width: 200px; height: 26px; border-radius: 6px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / .14); display: flex; align-items: center; padding: 0 8px; font-size: 12px;
    transition: box-shadow .2s;
  }
  .inp .ph { position: absolute; left: 8px; color: #b8b8be; }
  .mono { font-family: var(--mono); font-size: 11px; }
  .type { clip-path: inset(0 100% 0 0); }
  .t-name .type { transition: clip-path .8s steps(13); }
  .t-team .type { transition: clip-path .8s steps(10); }
  .req { font-style: normal; font-size: 10.5px; color: var(--warn); transition: opacity .2s; }
  .done { position: absolute; right: 8px; font-style: normal; color: var(--ok); opacity: 0; transition: opacity .2s; }
  .sh-foot { margin-top: auto; display: flex; align-items: center; gap: 8px; }
  .sh-foot small { margin-right: auto; display: inline-flex; gap: 4px; align-items: center; color: var(--app-muted); font-size: 10.5px; }
  .sh-foot small :global(svg) { color: var(--ok); }
  .b-cancel, .b-add { height: 26px; padding: 0 12px; border-radius: 6px; display: inline-flex; align-items: center; font-weight: 500; }
  .b-cancel { box-shadow: 0 0 0 1px rgb(0 0 0 / .14); }
  .b-add { background: var(--app-sel); color: #fff; transition: filter .1s, transform .1s; }

  .toast {
    position: absolute; left: 50%; bottom: 40px; transform: translate(-50%, 20px);
    display: inline-flex; align-items: center; gap: 8px;
    background: #1d1d1f; color: #fff; padding: 9px 14px; border-radius: 10px; font-size: 12.5px; font-weight: 500;
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / .45);
    opacity: 0; transition: opacity .3s, transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .toast :global(svg) { color: #32d74b; }

  /* ---------- desktop file + pointer ---------- */
  .dfile {
    position: absolute; left: 0; top: 0; width: 120px;
    display: grid; justify-items: center; gap: 6px;
    transform: translate(18px, 430px);
    transition: transform 1s cubic-bezier(.45,.05,.25,1), opacity .25s;
    z-index: 3;
  }
  .dfile-icon {
    width: 62px; height: 78px; border-radius: 6px 18px 6px 6px;
    background: linear-gradient(180deg, #fff, #f1f2f5);
    box-shadow: 0 0 0 1px rgb(0 0 0 / .08), 0 8px 18px -6px rgb(0 0 0 / .25);
    position: relative; display: grid; place-items: end center; padding-bottom: 12px;
    transition: transform .25s, box-shadow .25s;
  }
  .dfile-icon::before { content: ""; position: absolute; top: 0; right: 0; width: 18px; height: 18px; background: #dfe1e6; border-radius: 0 18px 0 6px; }
  .dfile-ext { background: var(--brand); color: #fff; font: 700 11px/1 var(--font); padding: 4px 7px; border-radius: 4px; letter-spacing: .04em; }
  .dfile-name {
    font-size: 11px; font-weight: 500; color: #3a1020; text-align: center;
    background: rgb(255 255 255 / .55); padding: 1px 6px; border-radius: 4px; transition: opacity .2s;
  }

  .cur {
    position: absolute; left: 0; top: 0; z-index: 5;
    transform: translate(560px, 660px);
    transition: transform .8s cubic-bezier(.45,.05,.25,1);
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / .3));
  }

  /* ---------- timeline ---------- */
  /* s1 pointer goes to the file */
  .s1 .cur { transform: translate(78px, 470px); }
  /* s2 grab */
  .s2 .dfile-icon { transform: scale(1.06) rotate(-3deg); box-shadow: 0 0 0 1px rgb(0 0 0 / .08), 0 22px 40px -10px rgb(0 0 0 / .4); }
  .s2 .dfile-name { opacity: 0; }
  /* s3 drag into the window */
  .s3 .dfile { transform: translate(470px, 240px); transition-duration: 1.1s; }
  .s3 .cur { transform: translate(538px, 282px); transition-duration: 1.1s; }
  /* s4 window shows the drop target */
  .s4 .dropzone { opacity: 1; }
  /* s5 drop: sheet opens */
  .s5 .dfile { opacity: 0; transform: translate(470px, 240px) scale(.4); transition: opacity .25s, transform .25s; }
  .s5 .dropzone { opacity: 0; }
  .s5 .scrim { opacity: 1; }
  .s5 .sheet { opacity: 1; transform: none; }
  .s5 .cur { transform: translate(700px, 300px); }
  /* s6, s7 facts read from the file */
  .s6 .f1, .s7 .f2 { opacity: 1; transform: none; }
  .s7 .f1 code, .s8 .f2 code { background: transparent; }
  /* s8 name typed */
  .s8 .t-name { box-shadow: 0 0 0 2px rgb(10 108 255 / .5); }
  .s8 .t-name .type { clip-path: inset(0 0 0 0); }
  /* s9 team id typed */
  .s9 .t-name { box-shadow: 0 0 0 1px rgb(0 0 0 / .14); }
  .s9 .t-team { box-shadow: 0 0 0 2px rgb(10 108 255 / .5); }
  .s9 .t-team .type { clip-path: inset(0 0 0 0); }
  .s9 .t-team .ph { opacity: 0; }
  .s9 .req { opacity: 0; }
  .s9 .done { opacity: 1; }
  /* s10 pointer to Add to Vault, s11 click */
  .s10 .cur { transform: translate(696px, 382px); }
  .s11 .b-add { filter: brightness(.82); transform: scale(.97); }
  /* s12 saved */
  .s12 .sheet { opacity: 0; transform: translateY(8px) scale(.98); }
  .s12 .scrim { opacity: 0; }
  .s12 .row.new { height: 40px; opacity: 1; }
  .s12 .n11 { display: none; } .s12 .n12 { display: inline; }
  .s12 .empty { opacity: 0; }
  .s12 .item { opacity: 1; transform: none; }
  .s12 .toast { opacity: 1; transform: translate(-50%, 0); }
  .s12 .cur { transform: translate(760px, 520px); }
  /* s13 encrypted */
  .s13 .enc { color: var(--ok); }

  .fade { opacity: 0; transition: opacity .45s; }
  .stage { transition: opacity .45s; }
</style>
