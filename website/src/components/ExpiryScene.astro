---
// Expiry: the Expiry list fills in with dates read from each file, then
// macOS shows DevVault's reminder (wording from notification_plan.dart).
import Icon from './Icon.astro';
import { u } from '../lib/url';

const rows = [
  { name: 'Distribution certificate', type: 'Apple Certificate', date: '4 Oct 2026', left: '3 days ago', tone: 'bad' },
  { name: 'Play publisher', type: 'GCP Service Account', date: '19 Oct 2026', left: '12 days', tone: 'warn' },
  { name: 'App Store profile', type: 'Provisioning Profile', date: '27 Oct 2026', left: '20 days', tone: 'warn' },
  { name: 'Upload keystore', type: 'Android Keystore', date: '14 Jan 2051', left: '24 years', tone: '' },
];
---
<div class="fit" data-w="680" data-h="480">
  <div class="stage" data-scene data-steps="300,550,800,1050,1600,2600,2900" data-loop="9000">
    <div class="card">
      <div class="head">
        <b>Expiry</b>
        <small>Every date is from a file or from you</small>
      </div>
      <div class="thead"><span>Name</span><span>Expires</span><span>Left</span><span>Date from</span></div>
      {rows.map((r, i) => (
        <div class={`row r${i + 1} ${r.tone}`}>
          <span class="nm"><b>{r.name}</b><small>{r.type}</small></span>
          <span class="dt">{r.date}</span>
          <span class="left">{r.left}</span>
          <span class="src"><Icon name="file" size={10} /> From file</span>
        </div>
      ))}
      <div class="foot"><Icon name="bell" size={11} /> Reminders on · at most two per item</div>
    </div>

    <div class="notif">
      <img src={u('icon.png')} alt="" width="34" height="34" />
      <div>
        <div class="n-top"><b>DevVault</b><small>now</small></div>
        <b class="n-title">“Play publisher” expires soon</b>
        <span class="n-body">It expires on 19 Oct 2026.</span>
      </div>
    </div>
  </div>
</div>

<style>
  .stage { font-family: var(--font); color: var(--app-text); transition: opacity .45s; }
  .card {
    position: absolute; left: 40px; top: 96px; width: 600px;
    background: #fff; border-radius: 14px; overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / .08), 0 30px 60px -20px rgb(120 60 0 / .35);
    font-size: 12.5px;
  }
  .head { padding: 14px 18px 10px; }
  .head b { display: block; font-size: 15px; }
  .head small { color: var(--app-muted); font-size: 11.5px; }
  .thead, .row { display: grid; grid-template-columns: 1fr 100px 90px 90px; align-items: center; padding: 0 18px; gap: 10px; }
  .thead { height: 28px; color: var(--app-muted); font-size: 11px; font-weight: 600; border-top: 1px solid var(--app-line); border-bottom: 1px solid var(--app-line); }
  .row {
    height: 50px; border-bottom: 1px solid #f0f0f3;
    opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s;
  }
  .nm b { display: block; font-weight: 600; }
  .nm small { color: var(--app-muted); font-size: 11px; }
  .dt { font-variant-numeric: tabular-nums; }
  .left { font-weight: 600; color: var(--app-muted); }
  .bad .left { color: var(--danger); }
  .warn .left { color: var(--warn); }
  .bad { background: #fff3f3; }
  .src {
    display: inline-flex; align-items: center; gap: 4px; justify-self: start;
    font-size: 10.5px; color: var(--app-muted); border: 1px solid var(--app-line); border-radius: 5px; padding: 1px 6px;
    opacity: 0; transform: scale(.8); transition: opacity .25s, transform .25s cubic-bezier(.3,1.6,.5,1);
  }
  .foot { display: flex; align-items: center; gap: 6px; padding: 10px 18px; color: var(--app-muted); font-size: 11px; }

  .notif {
    position: absolute; right: 24px; top: 22px; width: 330px;
    display: flex; gap: 10px; align-items: flex-start;
    padding: 12px 14px; border-radius: 16px;
    background: rgb(250 250 252 / .88); backdrop-filter: blur(20px);
    box-shadow: 0 0 0 1px rgb(0 0 0 / .06), 0 18px 40px -12px rgb(0 0 0 / .35);
    font-size: 12.5px;
    opacity: 0; transform: translateX(40px); transition: opacity .4s, transform .5s cubic-bezier(.2,.9,.2,1);
  }
  .notif img { border-radius: 8px; flex: none; }
  .n-top { display: flex; justify-content: space-between; font-size: 11px; color: var(--app-muted); }
  .n-top b { font-weight: 600; text-transform: uppercase; letter-spacing: .02em; font-size: 10.5px; }
  .n-title { display: block; font-weight: 600; margin-top: 2px; }
  .n-body { color: #3a3a3f; }

  .s1 .r1, .s2 .r2, .s3 .r3, .s4 .r4 { opacity: 1; transform: none; }
  .s5 .src { opacity: 1; transform: none; }
  .s5 .r2 .src { transition-delay: .08s; } .s5 .r3 .src { transition-delay: .16s; } .s5 .r4 .src { transition-delay: .24s; }
  .s6 .notif { opacity: 1; transform: none; }
  .s7 .r2 { background: #fff8e6; transition: background .4s; }
  .fade { opacity: 0; }
</style>
