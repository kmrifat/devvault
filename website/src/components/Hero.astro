---
import Icon from './Icon.astro';
import DropScene from './DropScene.astro';
import { links } from '../lib/links';
---
<section class="hero">
  <div class="wrap head">
    <a class="pill" href={links.releases}>
      <span>New</span> AI agents now ask first <Icon name="arrow-right" size={14} />
    </a>
    <h1>Your app's keys.<br /> <span class="grad">Safe in one place.</span></h1>
    <p class="sub">Drop in a certificate, keystore or API key. DevVault reads it and locks it away.</p>
    <div class="ctas">
      <a class="btn btn-primary" href={links.mac}><Icon name="download" size={17} /> Download for Mac</a>
      <a class="btn" href={links.linux}>Linux</a>
    </div>
    <p class="fine">Free and open source</p>
  </div>

  <div class="wrap">
    <div class="panel panel-rose visual">
      <DropScene />
    </div>
  </div>
</section>

<style>
  .hero { padding: 72px 0 0; }
  .head { display: grid; justify-items: center; text-align: center; gap: 22px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px 5px 5px; border-radius: 999px;
    background: #fff; border: 1px solid var(--line);
    font-size: 13.5px; color: var(--muted); font-weight: 500;
    box-shadow: 0 1px 2px rgb(0 0 0 / .04);
    transition: border-color .15s;
  }
  .pill:hover { border-color: #d0d3da; color: var(--ink); }
  .pill span { background: var(--ink); color: #fff; border-radius: 999px; padding: 2px 9px; font-size: 12px; font-weight: 600; }
  .sub { text-align: center; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .fine { color: var(--muted); font-size: 14px; margin-top: -8px; }
  .visual { margin-top: 56px; padding: 0; }
  @media (max-width: 640px) {
    .hero { padding-top: 44px; }
    .head h1 br { display: none; }
    .visual { margin-top: 36px; border-radius: 18px; }
    .ctas .btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
